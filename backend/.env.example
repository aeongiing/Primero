# 예시 환경변수 — 실제 값은 .env 에만 두고 커밋하지 않는다.

# DB
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/primero

# AWS
AWS_REGION=ap-northeast-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=your-bucket-name

# Auth (JWT) — 운영 배포 전 강력한 무작위 값으로 교체
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# Google OAuth — 프론트(NEXT_PUBLIC_GOOGLE_CLIENT_ID)와 동일한 Client ID
GOOGLE_CLIENT_ID=

# 브라우저 자동화 (Playwright)
BROWSER_HEADLESS=true

# Claude — 현재는 Anthropic 직접 API 사용. BEDROCK_MODEL_ID 는 Bedrock 전환 시.
BEDROCK_MODEL_ID=anthropic.claude-sonnet-4-20250514
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
ANTHROPIC_BASE_URL=

# OpenClaw
OPENCLAW_API_URL=

# Poller Worker
POLLING_INTERVAL_SECONDS=60
BROWSER_HEADLESS=true
SECRETS_MANAGER_PREFIX=parapara/platform
