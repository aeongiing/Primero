# 예시 환경변수 — 실제 값은 .env 에만 두고 커밋하지 않는다.

# DB
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/primero

# AWS
AWS_REGION=ap-northeast-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=your-bucket-name

# Auth (JWT) — 운영 배포 전 강력한 무작위 값으로 교체
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# OpenClaw
OPENCLAW_API_URL=
